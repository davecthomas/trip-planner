<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ meta.title }} · {{ meta.version_label }}</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><style>.s{stroke:%23c2410c}.f{fill:%23c2410c}@media(prefers-color-scheme:dark){.s{stroke:%23f97316}.f{fill:%23f97316}}</style><path class='s' d='M 5 24 Q 6 8 16 14 Q 26 20 27 6' fill='none' stroke-width='2.5' stroke-linecap='round'/><circle class='f' cx='5' cy='24' r='3'/><circle class='f' cx='16' cy='14' r='2.5'/><circle class='f' cx='27' cy='6' r='3'/></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
{{ inline_css }}
</style>
</head>
<body>

<header class="sticky">
  <div class="brand">
    <div class="name">{{ meta.title }}</div>
    <div class="meta">{{ meta.version_label }}</div>
  </div>

  <div class="plan-toggle" style="--plan-cols: {{ plans|length }}">
    {%- for plan in plans %}
    <button class="toggle-btn" data-plan="{{ plan.key }}">{{ plan.label.split('·')[0]|trim }}<span class="sub">{{ plan.tagline or (plan.label.split('·')[1:]|join('·')|trim) }}</span></button>
    {%- endfor %}
  </div>

  <div class="day-toggle" id="day-toggle"></div>

  <div class="trip-toggles">
    <a id="day-maps-toggle" href="#" target="_blank" rel="noopener"><span class="icon">↗</span><span class="label">Day 1 in Maps</span></a>
    <a id="full-maps-toggle" href="#" target="_blank" rel="noopener"><span class="icon">↗</span><span class="label">Full Trip in Maps</span></a>
    <button id="agenda-toggle"><span class="icon">☰</span><span class="label">Full Trip Agenda</span></button>
    <button id="merged-toggle"><span class="icon">⛁</span><span class="label">All Plans · Merged</span></button>
  </div>
</header>

<main>
  <section id="day-view"></section>
  <section id="agenda-view" hidden></section>
  <section id="merged-view" hidden></section>
</main>

<script>
window.__TRIP__ = {{ trip_json }};
</script>
<script>
{{ inline_js }}
</script>

</body>
</html>
