# Project-specific
samples/
renders/
.venv/

# Personal trip specs — keep PII (real addresses, hotel confirmations,
# phone numbers) out of git. Only the sanitized public sample is tracked,
# plus a .gitkeep so trips/private/ exists for fresh clones.
trips/*
!trips/sd_austin.yaml
!trips/.gitkeep
!trips/private/
trips/private/*
!trips/private/.gitkeep

